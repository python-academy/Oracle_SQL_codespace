cells:
  - kind: 1
    value: "### INSERT Statement"
    languageId: markdown
  - kind: 2
    value: select * from discount;
    languageId: oracle-sql
  - kind: 2
    value: |
      INSLRI INIO discount(discount_name,amount,start_date, expired_date)
      VALUES('Summer Promotaion',9.5,DATE '2017-05-01,'DATE '2017-08-31');
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      *
      FROM
      discounts;
    languageId: oracle-sql
  - kind: 2
    value: |
      INSERT INTO discounts(discount_name,amount,start_date,expired_date)
      VALUSE('Winter Promotaion 2017', 10.5,CURRENT_DATE,DATE '2017-12-31');
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      *
      FROM
      discounts;
    languageId: oracle-sql
  - kind: 2
    value: |
      INSERT INTO sales (custoner_id, product_id, order_date,total)
      SELECT customer_id,
      product_id,
      order_date,
      SUM(quantity * unit_price) amount
      FROM orders
      INNER JOIN order_items USING(order_id)
      MIERE status = 'Shipped '
      GROUP BY custoner_id,
      Product_id,
      order_date;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT *
      FROM sales
      ORDER BY order_date DESC,
      total DESC;
    languageId: oracle-sql
  - kind: 2
    value: |-
      /* CREATE TABLE sales_2017
      AS SELECT
      *
      FROM
      sales
      WHERE
      1 = 0;
      */
    languageId: oracle-sql
  - kind: 2
    value: |
      INSERT INTO sales_2017
      SELECT customer_id,
      product_id ,
      order_date,
      SUM(quantity * unit_price) amount
      FROM orders
      INNER JOIN order_itens USING(order_id)
      WHERE status = 'Shipped' AND EXTRACT(year from order_date) = 2017
      GROUP BY customer_id,
      product_id,
      order_date;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT *
      FROM sales_2017
      ORDER BY order_date DESC,
      total DESC;
    languageId: oracle-sql
  - kind: 2
    value: select * from customer_list;
    languageId: oracle-sql
  - kind: 2
    value: ""
    languageId: oracle-sql
  - kind: 2
    value: |
      INSERT INTO
      customer_list(
      first_name,
      last_name,
      enail,
      sent
      ) SELECT
      first_name,
      last_name,
      email,
      0
      FROM
      contacts;
    languageId: oracle-sql
  - kind: 1
    value: "### UPDATE Statement"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
      *
      FROM
      parts
      ORDER BY
      part_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      UPDATE
      parts
      SET
      cost =130
      WHERE
      part_id = 1;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      *
      FROM
      parts
      WHERE
      part_id = 1;
    languageId: oracle-sql
  - kind: 2
    value: |
      UPDATE
      parts
      SET
      lead_time = 30,
      cost = 120,
      status = 1
      WHERE
      part_id = 5;
    languageId: oracle-sql
  - kind: 2
    value: |
      UPDATE
      parts
      SET
      cost = cost* 1.05;
    languageId: oracle-sql
  - kind: 1
    value: "### DELETE Statment"
    languageId: markdown
  - kind: 2
    value: select * from sales;
    languageId: oracle-sql
  - kind: 2
    value: |
      DELETE
      FROM
      sales
      WHERE
      order_id = 1
      AND item_id =1;
    languageId: oracle-sql
  - kind: 2
    value: |
      DELETE
      FROM
      sales
      WHERE
      order_id = 1;
    languageId: oracle-sql
  - kind: 2
    value: DELETE FROM sales;
    languageId: oracle-sql
