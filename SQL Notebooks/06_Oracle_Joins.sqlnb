cells:
  - kind: 1
    value: "### JOIN operations"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
      a. id id_a,
      a. color color_a,
      b. id id_b,
      b. color color_b
      FROM
      palette_a a
      NNER JOIN palette_b b ON a.color = b. color;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      a-id id_a,
      a. color color_a,
      b. id id_b,
      b. color color_b
      FROM
      palette_a a
      LEFT JOIN palette_b b ON a. color = b. color;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      a. id id_a,
      a. color color_a,
      b. id id_b,
      b. color color_b
      FROM
      palette_a a
      LEFT JOIN palette_b b ON a.color = b.color
      WHERE b. id IS NULL;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      a. id id_a,
      a. color color_a,
      b. id id_b,
      b. color color_b
      FROM
      palette_a a
      RIGHT JOIN palette_b b ON a.color = b. color;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      a. id id_a,
      a. color color_a,
      b. id id_b,
      b. color color_b
      FROM
      palette_a a
      RIGHT JOIN palette_b b ON a. color = b.color
      WHERE a.id IS NULL;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      a. id id_a,
      a. color color_a,
      b.id id_b,
      b. color color b
      r-R0M
      palette_a a
      FULL OUTER JOIN palette_b b ON a. color
      = b. color;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      a,id id_a,
      a. color color_a,
      b. id id_b,
      b. color color_b
      FROM
      palette_a a
      FULL JOIN palette_b b ON a.color = b.color
      WHERE a.id IS NULL OR b.id IS NULL;
    languageId: oracle-sql
  - kind: 1
    value: "### INNER JOIN"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
      *
      FROM
      orders
      INNER JOIN order_items USING( order_id);
      ORDER BY
      order_date DESC;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
         name AS customer name,
         order_id,
         order_date,
         item_id,
         quantity,
         unit_price
      FROM
         orders
      INNER JOIN order_items USING(order_id)
      IVIER JOIN customers USING(customer_id)
      ORDER BY
            order_date DESC,
            order_id DESC,
            item_id ASC;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          name AS custcmer_name,
          order_id,
          order_date,
          item_id,
          product_name,
          quantity,
          unit_price
      FROM
          orders
      INNER JOIN order_items
                 USING(order_id)
      INNER JOIN custcmers
                 USING(customer_id)
      INNER JOIN products
                 USING(product_id)
      ORDER BY
      order_date DESC,
      order_id DESC,
      item_id ASC;
    languageId: oracle-sql
  - kind: 1
    value: "### LEFT JOIN"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
          order_id,
          status,
          first_name,
          last_name
      FROM
         orders
      LEFT JOIN = employees ON employee_id salesman_id
      ORDER BY
      order_date DESC;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          order_id,
          name AS customer_name,
          status ,
          first_name,
          last_name
      FROM
          orders
      LEFT JOIN employees ON
           employee_id = salesnan_id
      LEFT JOIN customers ON
           customer.customer_id = orders.customer_id
      ORDER BY
            order_date DESC;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          name,
          order_id,
          status,
          order_date
      FROM
          customers
      LEFT JOIN orders
                USING(customer_id)
      ORDER BY
            name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
           order_id,
           status,
           employee_id,
           last_name
      FROM
          orders
      LEFT JOIN employees ON
           enployee_id = salesman_id
      WHERE
          order_id = 58;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
           order_id,
           status'
           employee_id,
           last_name
      FROM
          orders
      LEFT JOIN employees ON
           enployee_id = salesman_id
      AND order_id = 58;
    languageId: oracle-sql
  - kind: 1
    value: "### RIGHT JOIN"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
          first_name,
          last_name,
          order_id,
          status
      FROM
         orders
      RIGHT JOIN employees ON
            employee_id = salesman_id
      WHERE
          job_title ='Sales Representative'
      ORDER BY
            first_name,
            last_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
         name,
         order_id,
         status
      FROM
           orders
      RIGHT JOIN customers
           USING(customer_id)
      ORDER BY
          name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          employee_id,
          last_name,
          first_name,
          order_id,
          status
      FROM
         orders
      RIGHT JOIN employees ON
             employee_id = salesman_id
      WHERE
          employee_id = 57;
    languageId: oracle-sql
  - kind: 1
    value: "### CROSS JOIN"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
           product_id,
           warehouse_id,
           ROUND(dbms_random.value(10,100)) quantity
      FROM
          products
      CROSS JOIN warehouses;
    languageId: oracle-sql
  - kind: 1
    value: "### SELF JOIN"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
      el. hire_date,
      (el.first_næme || ' ' || el.last_name) employee1,
      (e2.first_name || ' ' || e2.last_name) employee2
      FROM
      employees el
      INNER JOIN employees e2 ON
      e1.employee_id> e2.employee_id
      AND el.hire_date = e2.hire_date
      ORDER BY
      e1.hire_date DESC'
      employee1,
      employee2;
    languageId: oracle-sql
