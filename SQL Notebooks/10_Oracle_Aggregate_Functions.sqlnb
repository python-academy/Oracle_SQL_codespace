cells:
  - kind: 1
    value: "### AVG() Function"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
      ROUND(AVG(standard _ cost ), 2) avg_std_cost
      FROM
      products;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      ROUND(AVG(standard-cost),2) avg_std_cost.
      ROUND(AVG(list_price ) . 2) avg_list_price
      FROM
      products;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      RCJND(
      AVG( DISTINCT list_price ),
      2
      ) avg_list_price
      FROM
      products ;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      category_id,
      ROUND(
      AVG( list_pnce ).
      2
      ) avg_list_price
      FROM
      products
      GROUP BY
      category_id;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      category_name
      ROUND( AVG(list_price),2 ) avg_list_price
      FROM
      products
      INNER JOIN product_categories
      USING(category_id)
      GROUP BY
      category_name
      ORDER BY
      category_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      category_name,
      ROUND(
      AVG( list-price),
      2
      ) avg_list_price
      FROM
      products
      INNER JOIN product_categories
      USING(category-id)
      GROUP BY
      category_name
      HAVING
      AVG( list_price )> 1000
      ORDER BY
      category_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      ROUND( AVG( avg_list_price ) . 2) avg_of_avg
      FROM
      (
      SELECT
      AVG(list_price) avg_list_price
      FROM
      products
      GROUP BY
      category_id
      );
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT * FROM tests;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      AVG( score)
      FROM
      tests:
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      AVG( NVL( score, 0 ) )
      FROM
      tests ;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT * FROM items;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      COUNT (*)
      FROM
      items;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      COUNT(DISTINCT val)
      FROM
      items;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      COUNT( ALL val )
      FROM
      items;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      COUNT(*)
      FROM
      products;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      COUNT (*)
      FROM
      products
      WHERE
      category_id = 1;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      category_id ,
      COUNT(*)
      FROM
      products
      GROUP BY
      category_id
      ORDER BY
      category_id;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      category_name,
      COUNT( product_id )
      FROM
      product_categories
      LEFT JOIN products
      USING ( category_id)
      GROUP BY
      category_name
      ORDER BY
      category_name ;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      category_name,
      COUNT( product_id )
      FROM
      product_cateqories
       LEFT JOIN products
      USING(category-id)
      GROUP BY
      category_name
      HAVING
      COUNT( product_id ) > 50
      ORDER BY
      category_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      last_name,
      COUNT( last_name )
      FROM
      contacts
      GROUP BY
      last_nane
      HAVING
      COUNT( last_name)> 1
      ORDER BY
      last_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      MAX(list_price)
      FROM
      products:
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      product_id,
      product_name,
      list_price
      FROM
      products
      WHERE
      list_price =(
      SELECT
      MAX( list_price )
      FROM
      products
      );
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      category_ld,
      MAX(list_price )
      FROM
      products
      GROUP BY
      category_id
      ORDER BY
      category_id;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      category_name,
      MAX( list_price )
      FROM
      products
      INNER JOIN product_categories
      USING ( category_id)
      GROUP BY
      category_name
      ORDER BY
      category_name ;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      category_name,
      MAX( list_price )
      FROM
      products
      INNER JOIN product_categories
      USING(category_id)
      GROUP BY
      category_name
      HAVING
      MAX(list_price ) BETWEEN 3000 AND 6000
      ORDER BY
      category_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      MIN( list_price )
      FROM
      products;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      product_id,
      product_name ,
      list_price
      FROM
      products
      WHERE
      list_price =(
      SELECT
      MIN( list_price )
      FROM
      products
      );
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      category_id.
      MIN( list_price )
      FROM
      products
      GROUP BY
      category_ld
      ORDER BY
      category_ld;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      category_name,
      MIN( list_price )
      FROM
      products
      INNER JOIN product_categories
      USING(category_id)
      GROUP BY
      category_name
      ORDER BY
      category_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      category_name,
      MIN( list_price )
      FROM
      products
      INNER JOIN product_categories
      USING(category_id)
      GROUP BY
      category_name
      HAVING
      MIN( list_price )>500
      ORDER BY
      category_name ;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      SUM( quantity )
      FROM
      order_itens;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      product_id ,
      SUM( quantity )
      FROM
      order_items
      GROUP BY
      product_id
      ORDER BY
      SUM( quantity ) DESC;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      order-id,
      SUM( quantity * unit_price ) order_total
      FROM
      order_items
      GROUP BY
      order_id
      ORDER BY
      order_total;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      order-id,
      SUM( quantity * unit_price ) order_total
      FROM
      order_items
      GROUP BY
      order_id
      HAVING
      SUM( quantity * unit_price ) BETWEEN 1000 AND 20000
      ORDER BY
      order_total DESC;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      product_name,
      SUM( quantity * untt_price ) sales
      FROM
      order_items
      INNER JOIN products
      USING(product_id)
      GROUP BY
      product_name
      ORDER BY
      sales DESC;
    languageId: oracle-sql
