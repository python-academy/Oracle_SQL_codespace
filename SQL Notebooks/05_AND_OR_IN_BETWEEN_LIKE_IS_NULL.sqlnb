cells:
  - kind: 1
    value: "### AND clause"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
           order_id,
           customer_id.
           status,
           order_date
      FROM
          orders
      WHERE
            status = 'Shipped'
            AND salesman_id = 60
            AND EXTRACT(YEAR FROM order_date) = 2017
      ORDER BY
             order_date;
    languageId: oracle-sql
  - kind: 1
    value: "### OR clause"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
          order_id,
          customer_id,
          status,
          order_date
      FROM
         orders
      WHERE
         status = 'Pending'
         OR status 'Canceled '
      ORDER BY
      order_date DESC;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
           order_id,
           customer_id,
           status,
           salesman_id,
           order_date
      FROM
         orders
      WHERE
      (status = 'Canceled'
      status 'Pending')
      AND customer_id = 44
      ORDER BY
          order_date;
    languageId: oracle-sql
  - kind: 1
    value: "### IN clause"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
           order_id,
           customer_id
      status,
           salesman_id
      Form
         orders
      WHERE
         salesman_id IN (54, 55, 56)
      ORDER BY
           order_id;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
           order_id,
           custær_id,
           status,
           salesman_id
      FROM
         orders
      WHERE
         status IN ('Pending', 'Canceled')
      ORDER BY
      order_id;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
           order_id,
           customer_id,
           status ,
           salesman_id
      FROM
         orders
      WHERE
          status NOT IN ('Shipped', 'Canceled')
      ORDER BY
      order_id;
    languageId: oracle-sql
  - kind: 1
    value: "### SubQuery"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
          enployee_id ,
          first_name
          last_name
      FROM
         employees
      WHERE
         employee_id IN(
            SELECT
               DISTINCT salesman_id
      FROM
         orders
      WHERE
         status = 'Canceled');
      ORDER BY
         first_Name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          DISTINCT salesman_id
      FROM
         orders
      WHERE
         status = 'Canceled'
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          customer_id,
          name
      FROM
          customers
      WHERE
          customer_id NOT IN(
      SELECT
          customer_id
      From
      orders);
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          custcner_id,
      status,
          salesman_id
      FROM
         orders
      WHERE
         salesman_id IN( 60,
      61,
      62)
      ORDER BY
          customer id;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
           customer_id,
           status,
           salesman_id
      FROM
         orders
      WHERE
         salesman id = 60
         OR salesman id = 61
         OR salesman id = 62
      ORDER BY
      customer_id;
    languageId: oracle-sql
  - kind: 1
    value: "### BETWEEN clause"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
           product_name,
           standard_cost
      FROM
          products
      WHERE
         standard_cost BETÆEN 500 AND 600
      ORDER BY
         standard_cost ;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          product_name,
          standard_cost
      FROM
         products
      WHERE
         standard_cost NOT BETWEEN 500 AND 600
      ORDER BY
         product_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          order_id,
          customer_id,
          status,
          order_date
      FROM
         orders
      WHERE
         order_date BETWEEN '2016-12-01' AND DATE '2016-12-31'
      ORDER BY
         order_date ;
    languageId: oracle-sql
  - kind: 1
    value: "### LIKE clause"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
          first_name,
          last_name,
          phone
      FROM
          contacts
      WHERE
          last_name LIKE '%er'
      ORDER BY
          last_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          first_name,
          last_name,
          email
      FROM
         contacts
      WHERE
         UPPER( first_name ) LIKE 'CH%';
      ORDER BY
        first_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          first_name, last_name, phone
      FROM
         contacts
      WHERE
         phone NOT LIKE '+1%'
      ORDER BY
        first_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
         first_name,
         last_name,
         email,
         phone
      FROM
         contacts
      WHERE
         first_name  LIKE 'Je_i'
      ORDER BY
         first_name;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
          first_name,
          last_name,
          email,
          phone
      FROM
         contacts
      WHERE
         first_name LIKE 'Je_%';
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
           product_id ,
           discounts_message
      FROM
           discounts
      WHERE
           discount_message LIKE '%25!%%' ESCAPE '!';
    languageId: oracle-sql
  - kind: 1
    value: "### NULL operations"
    languageId: markdown
  - kind: 2
    value: |
      SELECT * FROM orders
      WHERE salesman_id = NULL
      ORDER BY order_date DESC;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT * FROM orders
      WHERE salesman_id IS NOT NULL
      ORDER BY order_date DESC;
    languageId: oracle-sql
