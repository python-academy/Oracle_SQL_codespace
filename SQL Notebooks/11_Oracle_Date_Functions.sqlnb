cells:
  - kind: 1
    value: "### ADD_MONTHS() Function"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
      ADD_MONTHS( DATE '2016-02-29', 1)
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      ADD_MONTHS(DATE'2016-03-31', -1)
      FROM
      dual;
    languageId: oracle-sql
  - kind: 1
    value: "### LAST_DAY() Function"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
      LAST_DAY( ADD_MONTHS(SYSDATE, -1))
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      SESSIONTIMEZONE
      FROM
      DUAL;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      CURRENT_DATE
      FROM
      DUAL;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      CURRENT_TIMESTAMP
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      CURRENT_TIMESTAMP
      FROM
      dual;
    languageId: oracle-sql
  - kind: 1
    value: "### EXTRACT() Function"
    languageId: markdown
  - kind: 2
    value: >
      SELECT

      EXTRACT( YEAR FROY TO_DATE('31-Dec-1999 15:30:20', 'Do-Mon-YYYY
      HH24:MI:SS')) YEAR

      FROM

      DUAL;
    languageId: oracle-sql
  - kind: 2
    value: >
      SELECT

      EXTRACT( MONTH FROM TO_DATE('31-Dec-1999 15:30:20', 'DD-Mon_YYYY
      HH24:MI:SS')) MONTH

      FROM

      DUAL;
    languageId: oracle-sql
  - kind: 2
    value: >
      SELECT

      EXTRACT( DAY FROM TO_DATE('31-Dec-1999 15:30:20', 'DO-MON-YYYY
      HH24:MI:SS')) DAY

      FROM

      DUAL;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      TO_CHAR(SYSDATE,'HH24') hour,
      TO_CHAR(SYSDATE,'MI') minute,
      TO_CHAR(SYSDATE,'SS') second,
      FROM
      DUAL;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      EXTRACT( YEAR FROM TIMESTAMP  '1999-12-31 23:59:59.10' )
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      EXTRACT( MONTH FROM TIMESTAMP '1999-12-31 23:59:59.10' )
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      EXTRACT( DAY FROM TIMESTAMP  '1999-12-31 23:59:59.10')
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      EXTRACT( HOUR FROM TIMESTAMP  '1999-12-31 23:59:59.10')
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      EXTRACT( MINUTE FROM TIMESTAMP '1999-12-31 23:59:59. 10')
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      EXTRACT( SECOND FROM TIMESTAMP '1999-12-31 23:59:59.10')
      FROY
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      EXTRACT(year FROM order_date) year,
      EXTRACT (month FROM order_date) month,
      COUNT (order_id) order_count
      FROM orders
      GROUP BY
      EXTRACT(YEAR FROM order_date),
      EXTRACT(MONTH FROM order_date)
      ORDER BY year DESC, month;
    languageId: oracle-sql
  - kind: 1
    value: "### TO_CHAR() Function"
    languageId: markdown
  - kind: 2
    value: |
      SELECT
      TO_CHAR(SYSDATE, 'MM-DD-YYYY HH24:MI:SS')
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      TO_DATE( '5 Jan 2017', 'DD MON YYYY')
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      TO_DATE('5 Jan 2017', 'DD MON YYY')
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      INSERT INTO members2( first_name, last_nane, joined_date)
      VALUES( 'Laureen' , 'Davidson' , 'Feb 01 2017' , 'Mon DD YYYY'));
    languageId: oracle-sql
  - kind: 2
    value: |
      INSERT INTO members2(first_name, last_name, joined_date)
      VALUES( 'Thomas' . 'Phelps', TO_DATE('15 March 2017' , 'DD Month YYYY'));
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      *
      FROM
      members2;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      TO_CHAR(sysdate, 'YYYY-MM-DO')
      FROM
      dull;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      TO_CHAR(sysdate, 'DL')
      FROM
      dual ;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      TO_CHAR(sysdate,
              'DL',
      'NLS_DATE_LANGUAGE FRENCH' )
      FROM
      dual;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      TO_CHAR(INTERVAL '600' SECOND, 'HH24:MM') result
      FROM
      DUAL;
    languageId: oracle-sql
  - kind: 2
    value: |
      SELECT
      first_name,
      last_name,
      TO_CHAR(hire_date, 'Q') joined_quarter
      FROM
      employees
      WHERE
      hire_date BETWEEN DATE '2016-01-01' AND date '2016-12-31'
      ORDER BY
      first_name, last_name;
    languageId: oracle-sql
